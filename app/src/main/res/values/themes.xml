<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.HMI" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/uos_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/uos_blue_dark</item>
        <item name="android:windowBackground">@color/surface_background</item>

        <!-- Edge-to-Edge System Bar Colors -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o">true</item>

        <item name="shapeAppearanceSmallComponent">@style/ShapeAppearance.HMI.Small</item>
        <item name="shapeAppearanceMediumComponent">@style/ShapeAppearance.HMI.Medium</item>
    </style>

    <style name="Theme.HMI" parent="Base.Theme.HMI" />

    <style name="ShapeAppearance.HMI.Small" parent="ShapeAppearance.Material3.SmallComponent">
        <item name="cornerSize">8dp</item>
    </style>

    <style name="ShapeAppearance.HMI.Medium" parent="ShapeAppearance.Material3.MediumComponent">
        <item name="cornerSize">16dp</item>
    </style>

    <style name="HMI.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/surface_card</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
    </style>
</resources>
