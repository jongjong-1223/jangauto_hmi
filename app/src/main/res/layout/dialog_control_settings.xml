<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="장치 설정"
        android:textSize="20sp"
        android:textStyle="bold"
        android:paddingBottom="16dp" />

    <Button
        android:id="@+id/btnPoweroff"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="⏻ 라즈베리파이 종료"
        android:backgroundTint="#C62828"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="20dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="옵션"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swVideo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="VIDEO" />
        <androidx.appcompat.widget.SwitchCompat
            android:id="@+id/swSafe"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="SAFE" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="속도 조절"
        android:textStyle="bold"
        android:paddingBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">
        <Button android:id="@+id/btnSlow" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="SLOW" android:textSize="12sp" />
        <Button android:id="@+id/btnMedium" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="MED" android:textSize="12sp" />
        <Button android:id="@+id/btnFast" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="FAST" android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
